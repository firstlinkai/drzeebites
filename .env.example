# --- Database (drzee-postgres container on VPS, TLS self-signed) ---
DATABASE_URI=postgres://drzee:<db-password>@<your-vps-ip>:5433/drzee_dev?sslmode=no-verify
# prod uses drzee_prod on same server

# --- Payload ---
PAYLOAD_SECRET=<generate>
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Stripe (TEST MODE) ---
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=<resend-api-key>
RESEND_AUDIENCE_ID=
ADMIN_NOTIFY_EMAIL=<admin-email>
EMAIL_FROM=DrZeeBites <onboarding@resend.dev>

# --- Downloads ---
DOWNLOAD_TOKEN_SECRET=<generate>

# --- Vercel (deploy phase only, not used by app) ---
VERCEL_TOKEN=<vercel-token>
# BLOB_READ_WRITE_TOKEN=   (created with Vercel Blob store in Phase 7; local dev uses disk storage)
